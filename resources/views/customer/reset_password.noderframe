html lang="en"
  head
    link rel="icon" type="image/png" href="/public/favicon.png"
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title "Reset password | TeenGirlsLK"
    link rel="stylesheet" href="/public/customer-auth.css"
  body
    main
      h1 "Reset your password"
      form#reset-form
        input type="hidden" name="_csrf" value="{{csrfToken}}"
        input type="hidden" name="token" value="{{token}}"
        label for="password" "New password"
        input#password type="password" name="password" required="required" minlength="8" autocomplete="new-password"
        label for="confirm-password" "Confirm new password"
        input#confirm-password type="password" name="confirmPassword" required="required" minlength="8" autocomplete="new-password"
        button type="submit" "Reset password"
      p data-feature-message="true" role="status"
      a href="/login" "Sign in"
    script type="module" src="/public/password-reset.js"
