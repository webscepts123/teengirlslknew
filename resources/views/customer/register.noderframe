html lang="en"
  head
    link rel="icon" type="image/png" href="/public/favicon.png"
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="robots" content="index, follow"
    title "{{pageTitle}} | {{siteName}}"
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    link rel="stylesheet" href="/public/vendor/fontawesome/css/all.min.css"
    link rel="stylesheet" href="/public/customer-auth.css"
    script type="module" src="/public/customer-register.js"
  body.tgl-auth-body.tgl-register-body
    a.tgl-floating-brand href="/"
      img.tgl-auth-site-logo src="/public/images/brand/teengirls-logo-wide.png" alt="Teengirls.lk home" width="170" height="70"

    main.tgl-auth-screen-layout.tgl-register-layout
      div.tgl-register-card
        div.tgl-register-head
          h1.tgl-register-title "Register"
          p.tgl-login-sub
            span "Already have an account? "
            a.tgl-pink-link href="/customer/login" "Sign in"

        if error
          div.tgl-alert.error
            span.fa-solid.fa-circle-exclamation
            span "{{error}}"

        if success
          div.tgl-alert.success
            span.fa-solid.fa-circle-check
            span "{{success}}"

        form#register-form.tgl-register-grid method="post" action="/customer/register" novalidate="novalidate"
          input type="hidden" name="_csrf" value="{{csrfToken}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-referral"
              span "Referral Code"
              span.tgl-optional "(Optional)"
            input#reg-referral.tgl-reg-input type="text" name="referralCode" value="{{old.referralCode}}" placeholder="Referral Code" maxlength="20" autocomplete="off"
            span.tgl-field-error data-error-for="referralCode" "{{errors.referralCode}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-first-name"
              span "First Name"
              span.tgl-req "*"
            input#reg-first-name.tgl-reg-input type="text" name="firstName" value="{{old.firstName}}" placeholder="First Name" maxlength="60" required="required" autocomplete="given-name"
            span.tgl-field-error data-error-for="firstName" "{{errors.firstName}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-last-name"
              span "Last Name"
              span.tgl-req "*"
            input#reg-last-name.tgl-reg-input type="text" name="lastName" value="{{old.lastName}}" placeholder="Last Name" maxlength="60" required="required" autocomplete="family-name"
            span.tgl-field-error data-error-for="lastName" "{{errors.lastName}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-email"
              span "E-mail Address"
              span.tgl-req "*"
            input#reg-email.tgl-reg-input type="email" name="email" value="{{old.email}}" placeholder="E-mail Address" maxlength="191" required="required" autocomplete="email"
            span.tgl-field-error data-error-for="email" "{{errors.email}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-phone"
              span "Phone Number"
              span.tgl-req "*"
            input#reg-phone.tgl-reg-input type="tel" name="phone" value="{{old.phone}}" placeholder="94771234567" maxlength="15" inputmode="numeric" required="required" autocomplete="tel"
            span.tgl-field-error data-error-for="phone" "{{errors.phone}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-nic"
              span "NIC Number"
              span.tgl-req "*"
            input#reg-nic.tgl-reg-input type="text" name="nic" value="{{old.nic}}" placeholder="980545355V or 199805403554" maxlength="12" required="required" autocomplete="off"
            span.tgl-field-error data-error-for="nic" "{{errors.nic}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-district"
              span "District"
              span.tgl-req "*"
            div.tgl-combo data-combo="district"
              input#reg-district.tgl-reg-input.tgl-combo-input type="text" name="district" value="{{old.district}}" placeholder="Search districts..." required="required" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="reg-district-list"
              span.fa-solid.fa-chevron-down.tgl-combo-caret aria-hidden="true"
              ul#reg-district-list.tgl-combo-list role="listbox" hidden="hidden"
            span.tgl-field-error data-error-for="district" "{{errors.district}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-city"
              span "City"
              span.tgl-req "*"
            div.tgl-combo data-combo="city"
              input#reg-city.tgl-reg-input.tgl-combo-input type="text" name="city" value="{{old.city}}" placeholder="Select a district first" required="required" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="reg-city-list"
              span.fa-solid.fa-chevron-down.tgl-combo-caret aria-hidden="true"
              ul#reg-city-list.tgl-combo-list role="listbox" hidden="hidden"
            span.tgl-field-error data-error-for="city" "{{errors.city}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-address"
              span "Address"
              span.tgl-req "*"
            input#reg-address.tgl-reg-input type="text" name="address" value="{{old.address}}" placeholder="Address" maxlength="255" required="required" autocomplete="street-address"
            span.tgl-field-error data-error-for="address" "{{errors.address}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-postal"
              span "Postal Code"
              span.tgl-req "*"
            input#reg-postal.tgl-reg-input type="text" name="postalCode" value="{{old.postalCode}}" placeholder="Postal Code" maxlength="5" inputmode="numeric" required="required" autocomplete="postal-code"
            span.tgl-field-error data-error-for="postalCode" "{{errors.postalCode}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-password"
              span "Password"
              span.tgl-req "*"
            div.tgl-input-wrapper
              input#reg-password.tgl-reg-input.has-action type="password" name="password" placeholder="Password" minlength="8" required="required" autocomplete="new-password"
              button.tgl-input-icon-btn.tgl-reg-eye type="button" data-toggle-password="reg-password" aria-label="Show password"
                span.fa-regular.fa-eye
            span.tgl-field-error data-error-for="password" "{{errors.password}}"

          div.tgl-reg-field
            label.tgl-reg-label for="reg-confirm-password"
              span "Confirm Password"
              span.tgl-req "*"
            div.tgl-input-wrapper
              input#reg-confirm-password.tgl-reg-input.has-action type="password" name="confirmPassword" placeholder="Confirm Password" minlength="8" required="required" autocomplete="new-password"
              button.tgl-input-icon-btn.tgl-reg-eye type="button" data-toggle-password="reg-confirm-password" aria-label="Show password"
                span.fa-regular.fa-eye
            span.tgl-field-error data-error-for="confirmPassword" "{{errors.confirmPassword}}"

          div.tgl-reg-actions
            button.tgl-btn-signin.tgl-btn-register type="submit"
              span "Register"
