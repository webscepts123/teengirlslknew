html lang="en"
  head
    link rel="icon" type="image/png" href="/public/favicon.png"
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="robots" content="noindex"
    title "{{pageTitle}} | {{siteName}}"
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    link rel="stylesheet" href="/public/vendor/fontawesome/css/all.min.css"
    link rel="stylesheet" href="/public/customer-auth.css"
  body.tgl-auth-body
    div.tgl-auth-orb.tgl-auth-orb-1 aria-hidden="true"
    div.tgl-auth-orb.tgl-auth-orb-2 aria-hidden="true"
    
    div.tgl-auth-container
      div.tgl-auth-header
        a.tgl-auth-brand href="/"
          img.tgl-auth-site-logo src="/public/images/brand/teengirls-logo-wide.png" alt="Teengirls.lk home" width="170" height="70"
        p.tgl-auth-tagline "Account Recovery"

      div.tgl-auth-card
        h1.tgl-auth-title "Reset Your Password"
        p.tgl-auth-desc "Enter your registered email address or mobile number. We'll send you an instant reset link and OTP."

        if error
          div.tgl-alert.error
            span.fa-solid.fa-circle-exclamation
            span "{{error}}"

        if success
          div.tgl-alert.success
            span.fa-solid.fa-circle-check
            span "{{success}}"

        form.tgl-form method="post" action="/customer/forgot-password"
          input type="hidden" name="_csrf" value="{{csrfToken}}"
          
          div.tgl-form-group
            label.tgl-label for="forgot-email" "Registered Email or Mobile Number"
            div.tgl-input-wrap
              span.fa-solid.fa-envelope.tgl-input-icon
              input#forgot-email.tgl-input type="text" name="emailOrPhone" placeholder="e.g. kavindi.silva@gmail.com" required="required" autocomplete="email"

          button.tgl-btn-submit type="submit"
            span "Send Recovery Link"
            span.fa-solid.fa-paper-plane

        div.tgl-auth-switch
          span "Remembered your password? "
          a.tgl-link href="/customer/login" "Back to Sign In"

      div style="text-align: center;"
        a.tgl-auth-back href="/"
          span.fa-solid.fa-store
          span "Return to TeenGirlsLK Store"
