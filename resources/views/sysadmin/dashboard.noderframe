              div.tgl-form-page-top
                div.tgl-form-page-nav
                  button.tgl-btn-back type="button" data-back="products"
                    span.tgl-back-arrow
                      span.fa-solid.fa-arrow-left
                    span "Back to Products"
                  div.tgl-breadcrumb-trail
                    span.tgl-bc-item onclick="switchTab('dashboard')" "Dashboard"
                    span.tgl-bc-sep "/"
                    span.tgl-bc-item onclick="switchTab('products')" "Products"
                    span.tgl-bc-sep "/"
                    span#prod-breadcrumb-current.tgl-bc-current "Add New Product"
                div.tgl-form-page-header
                  div.tgl-form-header-title-box
                    div.tgl-form-header-meta
                      span#modal-prod-badge.tgl-badge-pink "Product Catalog"
                      span#prod-mode-pill.tgl-status-pill.badge-active "Creating Entry"
                    h1#modal-prod-title.tgl-form-page-title "Add New Product"
                    p.tgl-form-page-sub "Configure merchandising details, retail pricing, inventory stock, and boutique photography."
                  div.tgl-form-header-actions
                    button.tgl-btn-outline#tgl-prod-cancel-top type="button" data-back="products" "Cancel"
                    button.tgl-btn-primary type="button" onclick="document.getElementById('tgl-product-form').requestSubmit()"
                      span.fa-solid.fa-floppy-disk
                      span "Save Product"
              form#tgl-product-form
                div.tgl-form-grid-layout
                  div.tgl-form-col
                    div.tgl-form-section-card
                      div.tgl-section-card-head
                        h3.tgl-section-card-title "General Merchandising Information"
                        p.tgl-section-card-sub "Primary product identifiers, SKU barcodes, and department categorisation"
                      div.tgl-section-card-body
                        div.tgl-form-grid
                          div.tgl-form-group.col-span-2
                            label.tgl-form-label for="prod-name"
                              span "Product Name"
                              span.tgl-req " *"
                            input#prod-name.tgl-input type="text" name="name" placeholder="e.g. Floral Summer Chiffon Maxi Dress" required="required"
                          div.tgl-form-group
                            label.tgl-form-label for="prod-sku"
                              span "SKU Code"
                              span.tgl-req " *"
                            div.tgl-input-action-wrap
                              input#prod-sku.tgl-input type="text" name="sku" placeholder="TG-DR-001" required="required"
                              button#btn-gen-sku.tgl-btn-inside type="button" title="Generate SKU" "Auto"
                          div.tgl-form-group
                            label.tgl-form-label for="prod-category"
                              span "Category"
                              span.tgl-req " *"
                            select#prod-category.tgl-select name="category" required="required"
                              option value="Dresses" "Dresses"
                              option value="Accessories" "Accessories"
                              option value="Tops & Knitwear" "Tops & Knitwear"
                              option value="Jewelry" "Jewelry"
                              option value="Footwear" "Footwear"
                              option value="Beauty" "Beauty"
                              option value="Bottoms" "Bottoms"
                    div.tgl-form-section-card
                      div.tgl-section-card-head
                        h3.tgl-section-card-title "Pricing & Stock Management"
                        p.tgl-section-card-sub "Set retail selling price and real-time inventory quantity allocation"
                      div.tgl-section-card-body
                        div.tgl-form-grid
                          div.tgl-form-group
                            label.tgl-form-label for="prod-price"
                              span "Retail Price (LKR)"
                              span.tgl-req " *"
                            div.tgl-input-prefix-wrap
                              span.tgl-input-prefix "Rs"
                              input#prod-price.tgl-input.has-prefix type="number" step="0.01" name="price" placeholder="3450.00" required="required"
                          div.tgl-form-group
                            label.tgl-form-label for="prod-stock"
                              span "Stock Quantity"
                              span.tgl-req " *"
                            input#prod-stock.tgl-input type="number" min="0" name="stock" placeholder="25" required="required"
                          div.tgl-form-group.col-span-2
                            label.tgl-form-label for="prod-status" "Listing & Fulfillment Status"
                            select#prod-status.tgl-select name="status"
                              option value="Active" "Active (Available on Storefront)"
                              option value="Low Stock" "Low Stock (Warning Alert)"
                              option value="Out of Stock" "Out of Stock (Backorder only)"
                              option value="Draft" "Draft (Hidden from Public)"
                    div.tgl-form-section-card
                      div.tgl-section-card-head
                        h3.tgl-section-card-title "Product Description & Styling Notes"
                        p.tgl-section-card-sub "Describe fabric composition, fit recommendations, and customer care tips"
                      div.tgl-section-card-body
                        div.tgl-form-group
                          label.tgl-form-label for="prod-desc" "Description & Styling Notes"
                          textarea#prod-desc.tgl-textarea name="description" rows="4" placeholder="Brief summary of fabrics, silhouette, fit, and model specs..."
                  div.tgl-form-col
                    div.tgl-form-section-card
                      div.tgl-section-card-head
                        h3.tgl-section-card-title "Product Photography & Media"
                        p.tgl-section-card-sub "Upload images or select curated boutique presets"
                      div.tgl-section-card-body
                        div.tgl-image-picker-zone
                          div.tgl-preview-thumb-box
                            img#prod-img-preview.tgl-preview-img src="/public/images/products/floral-maxi-dress.jpg" alt="Preview" onerror="this.src='/public/images/placeholder.svg'"
                          div.tgl-picker-controls
                            div.tgl-url-input-wrap
                              input#prod-img-url.tgl-input type="text" name="img" placeholder="Image URL or choose preset below" value="/public/images/products/floral-maxi-dress.jpg"
                            div.tgl-upload-row
                              label.tgl-btn-upload-file
                                input#prod-img-file type="file" accept="image/*" style="display:none;"
                                span.fa-solid.fa-folder-open
                                span " Choose Local Image"
                              span.tgl-picker-hint "or pick boutique preset:"
                            div.tgl-preset-chips
                              button.tgl-chip-btn type="button" data-preset="/public/images/products/floral-maxi-dress.jpg"
                                span.fa-solid.fa-person-dress
                                span " Maxi Dress"
                              button.tgl-chip-btn type="button" data-preset="/public/images/products/pink-crossbody-bag.jpg"
                                span.fa-solid.fa-bag-shopping
                                span " Pink Bag"
                              button.tgl-chip-btn type="button" data-preset="/public/images/products/lavender-cardigan.jpg"
                                span.fa-solid.fa-shirt
                                span " Cardigan"
                              button.tgl-chip-btn type="button" data-preset="/public/images/products/butterfly-hairpins.jpg"
                                span.fa-solid.fa-gem
                                span " Hairpins"
                              button.tgl-chip-btn type="button" data-preset="/public/images/products/pastel-sneakers.jpg"
                                span.fa-solid.fa-shoe-prints
                                span " Sneakers"
                              button.tgl-chip-btn type="button" data-preset="/public/images/products/lip-tint-trio.jpg"
                                span.fa-solid.fa-wand-magic-sparkles
                                span " Lip Tint"
                              button.tgl-chip-btn type="button" data-preset="/public/images/products/surprise-box.jpg"
                                span.fa-solid.fa-gift
                                span " Surprise Box"
                    div.tgl-form-section-card
                      div.tgl-section-card-head
                        h3.tgl-section-card-title "Available Sizing & Attributes"
                        p.tgl-section-card-sub "Standard TeenGirlsLK sizes for catalog filters"
                      div.tgl-section-card-body
                        div.tgl-options-cluster
                          label.tgl-option-check-label
                            input type="checkbox" checked="checked"
                            span "XS - Extra Small"
                          label.tgl-option-check-label
                            input type="checkbox" checked="checked"
                            span "S - Small"
                          label.tgl-option-check-label
                            input type="checkbox" checked="checked"
                            span "M - Medium"
                          label.tgl-option-check-label
                            input type="checkbox" checked="checked"
                            span "L - Large"
                          label.tgl-option-check-label
                            input type="checkbox"
                            span "XL - Free Size"
                div.tgl-form-actions-bar
                  button.tgl-btn-outline#tgl-prod-cancel type="button" data-back="products" "Cancel"
                  button.tgl-btn-primary#tgl-prod-submit type="submit"
                    span.fa-solid.fa-floppy-disk
                    span#tgl-prod-submit-text "Save Product"

