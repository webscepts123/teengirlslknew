html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="robots" content="noindex, nofollow"
    title "{{pageTitle}} | {{siteName}}"
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    link rel="stylesheet" href="/public/vendor/fontawesome/css/all.min.css"
    link rel="stylesheet" href="/public/admin-dashboard.css"
  body.tgl-admin-portal
    input type="hidden" name="_csrf" value="{{csrfToken}}"
    
    div.tgl-layout
      // Left Sidebar Navigation
      nav.tgl-sidebar
        div.tgl-sidebar-header
          a.tgl-brand-link href="/sysadmin/dashboard"
            div.tgl-brand-logo
              img.tgl-brand-logo-img src="/public/images/brand/logo-icon.svg" alt="TeenGirlsLK"
            span.tgl-brand-name "TeenGirlsLK"

        // Administrator Profile Quick Card
        div.tgl-admin-profile-card
          div.tgl-avatar-wrap
            div.tgl-avatar "{{adminInitials}}"
            span.tgl-avatar-status
          div.tgl-admin-meta
            span.tgl-admin-name "{{adminUser}}"
            span.tgl-admin-role "{{adminRole}}"
          button.tgl-profile-arrow type="button" aria-label="Profile actions"
            span.fa-solid.fa-chevron-right

        // Sidebar Navigation Links
        div.tgl-sidebar-nav
          // MAIN SECTION
          div.tgl-nav-group
            span.tgl-group-heading "MAIN"
            
            a.tgl-nav-item.active href="#dashboard" data-tab="dashboard"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="home"
                span "Dashboard"
            
            div.tgl-nav-accordion
              button.tgl-nav-item.tgl-accordion-btn type="button" data-toggle="sub-categories" data-tab="categories"
                div.tgl-nav-content
                  span.tgl-nav-icon data-icon="categories"
                  span "Categories"
                span.tgl-chevron
                  span.fa-solid.fa-chevron-right
              div#sub-categories.tgl-sub-menu
                a.tgl-sub-item href="#categories" data-tab="categories" "All Categories"
                a.tgl-sub-item href="#category-form" data-tab="category-form" data-action="add-category" "Add Category"
                a.tgl-sub-item href="#category-tree" onclick="showToast('Category hierarchy viewer', 'fa-network-wired')" "Hierarchy Tree"

            div.tgl-nav-accordion
              button.tgl-nav-item.tgl-accordion-btn type="button" data-toggle="sub-products" data-tab="products"
                div.tgl-nav-content
                  span.tgl-nav-icon data-icon="products"
                  span "Products"
                span.tgl-chevron
                  span.fa-solid.fa-chevron-right
              div#sub-products.tgl-sub-menu
                a.tgl-sub-item href="#products" data-tab="products" "All Products"
                a.tgl-sub-item href="#product-form" data-tab="product-form" data-action="add-product" "Add Product"
                a.tgl-sub-item href="#inventory" onclick="showToast('Inventory & stock control', 'fa-boxes-stacked')" "Stock & Inventory"
                a.tgl-sub-item href="#reviews" onclick="showToast('Customer product reviews', 'fa-star')" "Product Reviews"

            div.tgl-nav-accordion
              button.tgl-nav-item.tgl-accordion-btn type="button" data-toggle="sub-orders" data-tab="orders"
                div.tgl-nav-content
                  span.tgl-nav-icon data-icon="cart"
                  span "Orders"
                span.tgl-chevron
                  span.fa-solid.fa-chevron-right
              div#sub-orders.tgl-sub-menu
                a.tgl-sub-item href="#orders" data-tab="orders" "All Orders"
                a.tgl-sub-item href="#order-form" data-tab="order-form" data-action="new-order" "New Order"
                a.tgl-sub-item href="#orders-pending" onclick="showToast('Filtering pending orders', 'fa-clock')" "Pending Orders"
                a.tgl-sub-item href="#orders-shipped" onclick="showToast('Filtering shipped packages', 'fa-truck-fast')" "Shipped Orders"
                a.tgl-sub-item href="#orders-returns" onclick="showToast('Refund & returns list', 'fa-arrow-rotate-left')" "Return Requests"

            a.tgl-nav-item href="#delivery" data-tab="delivery"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="truck"
                span "Delivery"

            a.tgl-nav-item href="#payouts" data-tab="payouts"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="credit-card"
                span "Payouts"

            a.tgl-nav-item href="#customers" data-tab="customers"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="users"
                span "Customers"

          // PROMOTIONS SECTION
          div.tgl-nav-group
            span.tgl-group-heading "PROMOTIONS"

            a.tgl-nav-item href="#surprise-box" data-tab="surprise-box"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="star"
                span "Surprise Box"
              span.tgl-nav-badge "New"

            a.tgl-nav-item href="#promotions" data-tab="promotions"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="tag"
                span "Promotions"

            a.tgl-nav-item href="#flash-sale" data-tab="flash-sale"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="zap"
                span "Flash Sale"
              span.tgl-nav-badge.badge-hot "Live"

            a.tgl-nav-item href="#bidding" data-tab="bidding"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="dollar"
                span "Bidding"

            a.tgl-nav-item href="#coupons" data-tab="coupons"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="coupon"
                span "Coupons"

          // MANAGEMENT SECTION
          div.tgl-nav-group
            span.tgl-group-heading "MANAGEMENT"

            a.tgl-nav-item href="#manage-admin" data-tab="manage-admin"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="shield"
                span "Manage Admin"

            a.tgl-nav-item href="#reports" data-tab="reports"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="chart"
                span "Reports"

            a.tgl-nav-item href="#tickets" data-tab="tickets"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="ticket"
                span "Tickets"

            a.tgl-nav-item href="#faq" data-tab="faq"
              div.tgl-nav-content
                span.tgl-nav-icon data-icon="help-circle"
                span "FAQ"

        // Sidebar Footer Sign Out
        div.tgl-sidebar-footer
          a.tgl-nav-item.tgl-signout-link href="/sysadmin/logout"
            div.tgl-nav-content
              span.tgl-nav-icon data-icon="log-out"
              span "Sign Out"

      // Main Content Area
      main.tgl-main-wrapper
        // Top Navigation Bar
        header.tgl-topbar
          div.tgl-topbar-left
            button#tgl-mobile-toggle.tgl-btn-icon type="button" aria-label="Toggle navigation menu"
              span.tgl-nav-icon data-icon="menu"
            h1.tgl-page-title "Dashboard"

          // Global Search Bar with ⌘K
          div.tgl-search-bar
            span.tgl-search-icon data-icon="search"
            input#tgl-global-search.tgl-search-input type="text" placeholder="Search for anything..." aria-label="Search dashboard"
            span.tgl-kbd-shortcut "⌘ K"

          // Topbar Right Actions
          div.tgl-topbar-right
            // Date Range Picker Pill
            button#tgl-date-picker-btn.tgl-date-pill type="button" aria-label="Select date range"
              span "{{dateRange}}"
              span.tgl-icon-inline data-icon="calendar"

            // Notifications Bell with Badge
            div.tgl-dropdown-wrapper
              button#tgl-notification-btn.tgl-btn-icon.tgl-has-badge type="button" aria-label="Notifications"
                span.tgl-nav-icon data-icon="bell"
                span.tgl-badge-count "3"
              div#tgl-notification-dropdown.tgl-dropdown-menu
                div.tgl-dropdown-header
                  span "Recent Notifications"
                  button.tgl-link-btn type="button" onclick="showToast('All notifications marked read', 'fa-bell')" "Mark all read"
                div.tgl-dropdown-body
                  div.tgl-notif-row
                    span.tgl-notif-icon
                      span.fa-solid.fa-box
                    div.tgl-notif-meta
                      span.tgl-notif-text "Order #TG1004 is out for delivery"
                      span.tgl-notif-time "1 min ago"
                  div.tgl-notif-row
                    span.tgl-notif-icon
                      span.fa-solid.fa-truck
                    div.tgl-notif-meta
                      span.tgl-notif-text "Order #TG1003 has been shipped"
                      span.tgl-notif-time "2 hours ago"
                  div.tgl-notif-row
                    span.tgl-notif-icon
                      span.fa-solid.fa-user
                    div.tgl-notif-meta
                      span.tgl-notif-text "New customer registered: Guest Customer"
                      span.tgl-notif-time "5 hours ago"

            // Theme Toggle Switcher (Light / Dark)
            button#tgl-theme-toggle.tgl-btn-icon type="button" aria-label="Toggle visual theme" title="Toggle Theme"
              span.tgl-nav-icon data-icon="sun"

            // Admin Profile Summary Pill
            div.tgl-topbar-profile
              img.tgl-avatar-small-img src="/public/images/avatars/admin-avatar.jpg" alt="{{adminUser}}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              div.tgl-avatar-small style="display:none;" "{{adminInitials}}"
              div.tgl-profile-col
                span.tgl-topbar-name "{{adminUser}}"
                span.tgl-topbar-role "{{adminRole}}"

        // Page Content Tabs
        div.tgl-content-body
          // DASHBOARD MAIN TAB
          div#tab-dashboard.tgl-tab-pane.active
            // 1. TOP METRIC CARDS (6 CARDS ROW)
            // 1. TOP METRIC CARDS (6 CARDS ROW)
            div.tgl-kpi-grid
              // Card 1: Total Customers
              div.tgl-card.tgl-kpi-card
                div.tgl-kpi-header
                  div.tgl-icon-box.icon-purple
                    span.fa-solid.fa-users
                  div.tgl-kpi-titles
                    span.tgl-kpi-label "Total Customers"
                    span.tgl-kpi-number "3"
                div.tgl-kpi-trend.trend-text-down
                  span.fa-solid.fa-arrow-trend-down.trend-arrow
                  span "25% vs last 31 days"

              // Card 2: Active Users
              div.tgl-card.tgl-kpi-card
                div.tgl-kpi-header
                  div.tgl-icon-box.icon-green
                    span.fa-solid.fa-user
                  div.tgl-kpi-titles
                    span.tgl-kpi-label "Active Users"
                    span.tgl-kpi-number "2"
                div.tgl-kpi-trend.trend-text-up
                  span.fa-solid.fa-arrow-trend-up.trend-arrow
                  span "100% vs last 31 days"

              // Card 3: Total Revenue
              div.tgl-card.tgl-kpi-card
                div.tgl-kpi-header
                  div.tgl-icon-box.icon-pink
                    span.fa-regular.fa-credit-card
                  div.tgl-kpi-titles
                    span.tgl-kpi-label "Total Revenue"
                    span.tgl-kpi-number "Rs 0.00"
                div.tgl-kpi-trend.trend-text-down
                  span.fa-solid.fa-arrow-trend-down.trend-arrow
                  span "100% vs last 31 days"

              // Card 4: Total Sales
              div.tgl-card.tgl-kpi-card
                div.tgl-kpi-header
                  div.tgl-icon-box.icon-blue
                    span.fa-solid.fa-bag-shopping
                  div.tgl-kpi-titles
                    span.tgl-kpi-label "Total Sales"
                    span.tgl-kpi-number "0"
                div.tgl-kpi-trend.trend-text-down
                  span.fa-solid.fa-arrow-trend-down.trend-arrow
                  span "100% vs last 31 days"

              // Card 5: Total Orders
              div.tgl-card.tgl-kpi-card
                div.tgl-kpi-header
                  div.tgl-icon-box.icon-orange
                    span.fa-solid.fa-clipboard-list
                  div.tgl-kpi-titles
                    span.tgl-kpi-label "Total Orders"
                    span.tgl-kpi-number "4"
                div.tgl-kpi-trend.trend-text-down
                  span.fa-solid.fa-arrow-trend-down.trend-arrow
                  span "20% vs last 31 days"

              // Card 6: Return Orders
              div.tgl-card.tgl-kpi-card
                div.tgl-kpi-header
                  div.tgl-icon-box.icon-rose
                    span.fa-solid.fa-rotate-left
                  div.tgl-kpi-titles
                    span.tgl-kpi-label "Return Orders"
                    span.tgl-kpi-number "0"
                div.tgl-kpi-trend.trend-text-neutral
                  span "No change"

            // 2. MAIN 2-COLUMN DASHBOARD GRID
            div.tgl-dashboard-grid
              // LEFT MAIN COLUMN (Fulfillment + Middle Row + Recent Orders)
              div.tgl-dashboard-main
                // Fulfillment Status Pipeline (4 Cards)
                div.tgl-fulfillment-grid
                  div.tgl-card.tgl-fulfill-card
                    div.tgl-fulfill-content
                      div.tgl-icon-box.icon-blue-soft
                        span.fa-solid.fa-truck
                      div.tgl-fulfill-meta
                        div.tgl-fulfill-top
                          span.tgl-fulfill-label "Dispatched"
                          span.tgl-fulfill-count "0"
                        span.tgl-fulfill-desc "Packed, awaiting pickup"

                  div.tgl-card.tgl-fulfill-card
                    div.tgl-fulfill-content
                      div.tgl-icon-box.icon-purple-soft
                        span.fa-solid.fa-box
                      div.tgl-fulfill-meta
                        div.tgl-fulfill-top
                          span.tgl-fulfill-label "Shipped"
                          span.tgl-fulfill-count "1"
                        span.tgl-fulfill-desc "With the courier"

                  div.tgl-card.tgl-fulfill-card
                    div.tgl-fulfill-content
                      div.tgl-icon-box.icon-orange-soft
                        span.fa-solid.fa-clock-rotate-left
                      div.tgl-fulfill-meta
                        div.tgl-fulfill-top
                          span.tgl-fulfill-label "Out for Delivery"
                          span.tgl-fulfill-count "1"
                        span.tgl-fulfill-desc "After shipped"

                  div.tgl-card.tgl-fulfill-card
                    div.tgl-fulfill-content
                      div.tgl-icon-box.icon-green-soft
                        span.fa-solid.fa-circle-check
                      div.tgl-fulfill-meta
                        div.tgl-fulfill-top
                          span.tgl-fulfill-label "Delivered"
                          span.tgl-fulfill-count "0"
                        span.tgl-fulfill-desc "Handed to the customer"

                // Middle Grid: Revenue Overview + Sales by Category (Side-by-Side)
                div.tgl-middle-grid
                  // Revenue Overview Card
                  div.tgl-card.tgl-chart-card
                    div.tgl-card-head
                      div
                        h2.tgl-card-title "Revenue Overview"
                        p.tgl-card-sub "Daily revenue (monthly view for ranges > 31 days)"
                      div.tgl-filter-dropdown
                        button.tgl-btn-filter type="button"
                          span "Daily"
                          span.fa-solid.fa-chevron-down style="font-size: 0.65rem; margin-left: 4px;"
                    
                    // Interactive SVG Revenue Chart Container
                    div#tgl-revenue-chart-mount.tgl-chart-container

                    // Bottom 3 Revenue Metrics Pills
                    div.tgl-revenue-stats
                      div.tgl-revenue-pill
                        div.tgl-pill-icon.icon-pink
                          span.fa-regular.fa-credit-card
                        div
                          div.tgl-pill-val "Rs 0.00"
                          div.tgl-pill-label "Total Revenue"

                      div.tgl-revenue-pill
                        div.tgl-pill-icon.icon-green
                          span.fa-solid.fa-arrow-trend-down
                        div
                          div.tgl-pill-val.trend-text-down
                            span.fa-solid.fa-arrow-trend-down style="font-size:0.8rem; margin-right:0.25rem;"
                            span "100%"
                          div.tgl-pill-label "vs May 10 - Jun 8, 2025"

                      div.tgl-revenue-pill
                        div.tgl-pill-icon.icon-purple
                          span.fa-solid.fa-chart-column
                        div
                          div.tgl-pill-val "Rs 0.00"
                          div.tgl-pill-label "Average Daily Revenue"

                  // Sales by Category Card
                  div.tgl-card.tgl-category-card
                    div.tgl-card-head
                      div
                        h2.tgl-card-title "Sales by Category"
                        p.tgl-card-sub "Units ordered per main category"
                    
                    div#tgl-donut-chart-mount.tgl-donut-container
                    
                    div.tgl-category-card-footer
                      a.tgl-btn-view-categories href="#categories" data-tab="categories"
                        span "View All Categories"
                        span.fa-solid.fa-arrow-right style="margin-left: 6px;"

                // Recent Orders Card
                div.tgl-card.tgl-orders-card
                  div.tgl-orders-header
                    h2.tgl-card-title "Recent Orders"
                    a.tgl-btn-pink-pill href="#orders" data-tab="orders"
                      span "View All Orders"
                      span.fa-solid.fa-arrow-right style="margin-left: 6px;"

                  div.tgl-table-wrap.table-orders
                    div.tgl-thead
                      div.tgl-th.col-order-id "ORDER ID"
                      div.tgl-th.col-order-cust "CUSTOMER"
                      div.tgl-th.col-order-date "DATE"
                      div.tgl-th.col-order-status "STATUS"
                      div.tgl-th.col-order-total "TOTAL"
                      div.tgl-th.col-order-pay "PAYMENT"
                      div.tgl-th.col-order-act ""
                    div.tgl-tbody
                      div.tgl-tr
                        div.tgl-td.col-order-id
                          a.tgl-order-id-link href="#orders" data-order-view="#TG1004" "#TG1004"
                        div.tgl-td.col-order-cust "Guest Customer"
                        div.tgl-td.col-order-date "Jun 9, 2025 11:17 AM"
                        div.tgl-td.col-order-status
                          span.tgl-status-pill.status-delivery
                            span.fa-regular.fa-circle-dot style="font-size: 0.68rem; margin-right: 4px;"
                            span "Out for Delivery"
                        div.tgl-td.col-order-total "Rs 1,799.00"
                        div.tgl-td.col-order-pay
                          span.tgl-pay-badge.pay-cod "Cod"
                        div.tgl-td.col-order-act
                          button.tgl-btn-dots type="button" aria-label="Order actions" title="Actions"
                            span.fa-solid.fa-ellipsis-vertical

              // RIGHT SIDEBAR COLUMN (Quick Summary + Top Performing + Recent Activity)
              div.tgl-dashboard-sidebar
                // Quick Summary Card
                div.tgl-card.tgl-widget-card
                  h3.tgl-widget-title "Quick Summary"
                  div.tgl-summary-list
                    a.tgl-summary-row href="#products" data-tab="products"
                      div.tgl-summary-left
                        div.tgl-icon-box.icon-pink
                          span.fa-solid.fa-bag-shopping
                        span.tgl-summary-label "Products"
                      div.tgl-summary-right
                        span.tgl-summary-count "12"
                        span.tgl-summary-arrow
                          span.fa-solid.fa-chevron-right style="font-size: 0.75rem;"

                    a.tgl-summary-row href="#categories" data-tab="categories"
                      div.tgl-summary-left
                        div.tgl-icon-box.icon-orange
                          span.fa-solid.fa-table-cells-large
                        span.tgl-summary-label "Categories"
                      div.tgl-summary-right
                        span.tgl-summary-count "7"
                        span.tgl-summary-arrow
                          span.fa-solid.fa-chevron-right style="font-size: 0.75rem;"

                    a.tgl-summary-row href="#promotions" data-tab="promotions"
                      div.tgl-summary-left
                        div.tgl-icon-box.icon-green
                          span.fa-solid.fa-bullhorn
                        span.tgl-summary-label "Active Promotions"
                      div.tgl-summary-right
                        span.tgl-summary-count "3"
                        span.tgl-summary-arrow
                          span.fa-solid.fa-chevron-right style="font-size: 0.75rem;"

                    a.tgl-summary-row href="#flash-sale" data-tab="flash-sale"
                      div.tgl-summary-left
                        div.tgl-icon-box.icon-purple
                          span.fa-solid.fa-bolt
                        span.tgl-summary-label "Flash Sale"
                      div.tgl-summary-right
                        span.tgl-summary-count "1"
                        span.tgl-summary-arrow
                          span.fa-solid.fa-chevron-right style="font-size: 0.75rem;"

                // Top Performing Categories Card
                div.tgl-card.tgl-widget-card
                  div.tgl-widget-head
                    h3.tgl-widget-title "Top Performing Categories"
                    span.tgl-badge-pink "This Month"
                  
                  div.tgl-empty-leaderboard
                    div.tgl-empty-icon
                      span.fa-solid.fa-chart-simple
                    div.tgl-empty-title "No sales data yet"
                    p.tgl-empty-sub "Category performance will appear here once you have sales."

                // Recent Activity Card
                div.tgl-card.tgl-widget-card
                  h3.tgl-widget-title "Recent Activity"
                  div.tgl-activity-list
                    div.tgl-activity-row
                      div.tgl-icon-box.icon-pink-soft
                        span.fa-solid.fa-cart-shopping
                      div.tgl-activity-meta
                        span.tgl-activity-title "Order #TG1004 is out for delivery"
                        span.tgl-activity-time "1 minute ago"

                    div.tgl-activity-row
                      div.tgl-icon-box.icon-purple-soft
                        span.fa-solid.fa-truck
                      div.tgl-activity-meta
                        span.tgl-activity-title "Order #TG1003 has been shipped"
                        span.tgl-activity-time "2 hours ago"

                    div.tgl-activity-row
                      div.tgl-icon-box.icon-blue-soft
                        span.fa-solid.fa-box
                      div.tgl-activity-meta
                        span.tgl-activity-title "Order #TG1002 has been dispatched"
                        span.tgl-activity-time "4 hours ago"

          // CATEGORIES TAB
          div#tab-categories.tgl-tab-pane
            div.tgl-card
              div.tgl-card-head
                div
                  h2.tgl-card-title "Category Management"
                  p.tgl-card-sub "Organize e-commerce catalog structure, tags, and navigation filters"
                button.tgl-btn-primary#btn-add-category type="button" data-action="add-category" "+ Add Category"
              div.tgl-categories-grid
                div.tgl-cat-card
                  div.tgl-cat-icon
                    span.fa-solid.fa-person-dress style="color: #FF2A7A;"
                  h3 "Dresses & Outfits"
                  p "14 products listed"
                  button.tgl-btn-xs-outline type="button" data-action="edit-category" data-cat-name="Dresses & Outfits" data-cat-slug="dresses-outfits" data-cat-icon="fa-person-dress" "Edit"
                div.tgl-cat-card
                  div.tgl-cat-icon
                    span.fa-solid.fa-bag-shopping style="color: #06B6D4;"
                  h3 "Bags & Accessories"
                  p "9 products listed"
                  button.tgl-btn-xs-outline type="button" data-action="edit-category" data-cat-name="Bags & Accessories" data-cat-slug="bags-accessories" data-cat-icon="fa-bag-shopping" "Edit"
                div.tgl-cat-card
                  div.tgl-cat-icon
                    span.fa-solid.fa-shoe-prints style="color: #F59E0B;"
                  h3 "Footwear"
                  p "6 products listed"
                  button.tgl-btn-xs-outline type="button" data-action="edit-category" data-cat-name="Footwear" data-cat-slug="footwear" data-cat-icon="fa-shoe-prints" "Edit"
                div.tgl-cat-card
                  div.tgl-cat-icon
                    span.fa-solid.fa-wand-magic-sparkles style="color: #EC4899;"
                  h3 "Beauty & Skincare"
                  p "11 products listed"
                  button.tgl-btn-xs-outline type="button" data-action="edit-category" data-cat-name="Beauty & Skincare" data-cat-slug="beauty-skincare" data-cat-icon="fa-wand-magic-sparkles" "Edit"

          // PRODUCTS TAB
          div#tab-products.tgl-tab-pane
            div.tgl-card
              div.tgl-card-head
                div
                  h2.tgl-card-title "Product Catalog"
