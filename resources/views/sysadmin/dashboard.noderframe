                              span "Email Address"
                              span.tgl-req " *"
                            input#cust-email.tgl-input type="email" name="custEmail" placeholder="name@example.com" required="required"
                          div.tgl-form-group
                            label.tgl-form-label for="cust-phone" "Phone / WhatsApp"
                            input#cust-phone.tgl-input type="tel" name="custPhone" placeholder="+94 77 123 4567"
                          div.tgl-form-group.col-span-2
                            label.tgl-form-label for="cust-city" "City / Delivery Region"
                            input#cust-city.tgl-input type="text" name="custCity" placeholder="Colombo 07"
                  div.tgl-form-col
                    div.tgl-form-section-card
                      div.tgl-section-card-head
                        h3.tgl-section-card-title "Membership & Account Privileges"
                        p.tgl-section-card-sub "Loyalty club tier, discount perks, and internal notes"
                      div.tgl-section-card-body
                        div.tgl-form-grid
                          div.tgl-form-group.col-span-2
                            label.tgl-form-label for="cust-tier" "Membership Club Tier"
                            select#cust-tier.tgl-select name="custTier"
                              option value="VIP Gold" "VIP Gold (15% Store Perk)"
                              option value="Silver Club" "Silver Club (10% Store Perk)"
                              option value="Bronze" "Bronze (Standard Member)"
                              option value="Guest" "Guest (One-time Buyer)"
                div.tgl-form-actions-bar
                  button.tgl-btn-outline#tgl-cust-cancel type="button" data-back="customers" "Cancel"
                  button.tgl-btn-primary#tgl-cust-submit type="submit"
                    span.fa-solid.fa-user
                    span "Save Customer"

          // ORDER DETAILS & EDIT PAGE (SEPARATE PAGE)
          div#tab-order-form.tgl-tab-pane
            div.tgl-form-page-wrapper
              div.tgl-form-page-top
                div.tgl-form-page-nav
                  button.tgl-btn-back type="button" data-back="orders"
                    span.tgl-back-arrow
                      span.fa-solid.fa-arrow-left
                    span "Back to Orders"
                  div.tgl-breadcrumb-trail
                    span.tgl-bc-item onclick="switchTab('dashboard')" "Dashboard"
                    span.tgl-bc-sep "/"
                    span.tgl-bc-item onclick="switchTab('orders')" "Orders"
                    span.tgl-bc-sep "/"
                    span#order-breadcrumb-current.tgl-bc-current "Order #TG1004"
                div.tgl-form-page-header
                  div.tgl-form-header-title-box
                    div.tgl-form-header-meta
                      span.tgl-badge-pink "Order Processing"
                      span#modal-order-badge.tgl-status-pill.badge-active "Processing"
                    h1#modal-order-title.tgl-form-page-title "Order #TG1004"
                    p#order-page-meta-sub.tgl-form-page-sub "Customer order details, items purchased, shipment progression, and payment slip."
                  div.tgl-form-header-actions
                    button.tgl-btn-outline#tgl-modal-print type="button"
                      span.fa-solid.fa-print
                      span "Print Packing Slip"
                    button.tgl-btn-primary#tgl-modal-action type="button"
                      span.fa-solid.fa-check
                      span "Mark as Delivered"
              div#tgl-modal-content.tgl-order-page-body
                // Rendered dynamically by openOrderPage()
              div.tgl-form-actions-bar
                button.tgl-btn-outline type="button" data-back="orders" "Back to Orders"
                button.tgl-btn-primary type="button" onclick="showToast('Order status and notes updated! ', 'fa-box')" "Update Order Status"

    // Floating Bulk Action Bar
    div#tgl-bulk-actions-bar.tgl-bulk-bar aria-hidden="true"
      div.tgl-bulk-inner
        div.tgl-bulk-badge
          span#tgl-bulk-count "0"
          span "selected"
        div.tgl-bulk-actions
          button.tgl-bulk-btn#tgl-bulk-export type="button"
            span.fa-solid.fa-download
            span "Export Selected"
          button.tgl-bulk-btn#tgl-bulk-status type="button"
            span.fa-solid.fa-bolt
            span "Mark Completed"
          button.tgl-bulk-btn.btn-danger#tgl-bulk-delete type="button"
            span.fa-solid.fa-trash-can
            span "Batch Delete"
          button.tgl-bulk-clear#tgl-bulk-clear type="button" aria-label="Clear selection" title="Deselect All"
            span.fa-solid.fa-xmark

    // Interactive Toast Notification
    div#tgl-toast-container.tgl-toast-container aria-live="polite"

    // Scripts
    script src="/public/admin-dashboard.js" defer="defer"
