                    span "ORDER ID"
                    span.tgl-sort-icon
                      span.fa-solid.fa-sort
                  div.tgl-th.sortable data-sort="cust" data-type="text"
                    span "CUSTOMER"
                    span.tgl-sort-icon
                      span.fa-solid.fa-sort
                  div.tgl-th.sortable data-sort="date" data-type="date"
                    span "DATE"
                    span.tgl-sort-icon
                      span.fa-solid.fa-sort
                  div.tgl-th.sortable data-sort="status" data-type="text"
                    span "STATUS"
                    span.tgl-sort-icon
                      span.fa-solid.fa-sort
                  div.tgl-th.sortable data-sort="total" data-type="currency"
                    span "TOTAL"
                    span.tgl-sort-icon
                      span.fa-solid.fa-sort
                  div.tgl-th.sortable data-sort="pay" data-type="text"
                    span "PAYMENT"
                    span.tgl-sort-icon
                      span.fa-solid.fa-sort
                  div.tgl-th.col-act "ACTIONS"
                div.tgl-tbody
                  for order in recentOrders
                    div.tgl-tr data-id="{{order.id}}" data-cust="{{order.customer}}" data-date="{{order.date}}" data-status="{{order.status}}" data-total="{{order.total}}" data-pay="{{order.payment}}"
                      div.tgl-td.col-check
                        input.tgl-row-check type="checkbox" aria-label="Select order {{order.id}}"
                      div.tgl-td.col-id
                        a.tgl-order-link href="#orders" data-order-view="{{order.id}}" "{{order.id}}"
                      div.tgl-td.col-cust
                        div.tgl-cust-cell
                          span.tgl-cust-avatar "{{order.initials}}"
                          span.tgl-customer-name "{{order.customer}}"
                      div.tgl-td.col-date
                        span.tgl-order-date "{{order.date}}"
                      div.tgl-td.col-status
                        span.tgl-status-pill class="{{order.statusBadge}}"
                          span.status-dot
                          span "{{order.status}}"
                      div.tgl-td.col-total
                        strong.tgl-order-total "{{order.total}}"
                      div.tgl-td.col-pay
                        span.tgl-pay-pill class="{{order.paymentBadge}}" "{{order.payment}}"
                      div.tgl-td.col-act
                        button.tgl-btn-more type="button" aria-label="Order actions" data-order-view="{{order.id}}" title="View Order Details"
                          span.fa-solid.fa-eye

