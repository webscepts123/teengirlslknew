                      span.fa-solid.fa-xmark
                  div.tgl-filter-select-wrap
                    select.tgl-table-filter data-filter-col="status" aria-label="Filter by Status"
                      option value="" "All Statuses"
                      option value="Out for Delivery" "Out for Delivery"
                      option value="Shipped" "Shipped"
                      option value="Dispatched" "Dispatched"
                      option value="Delivered" "Delivered"
                      option value="Processing" "Processing"
                  div.tgl-filter-select-wrap
                    select.tgl-table-filter data-filter-col="pay" aria-label="Filter by Payment"
                      option value="" "All Payments"
                      option value="Card" "Card"
                      option value="Cod" "Cash on Delivery (COD)"
                      option value="Bank" "Bank Transfer"
                div.tgl-toolbar-right
                  button.tgl-btn-toolbar.tgl-density-toggle type="button" title="Toggle Table Density"
                    span.fa-solid.fa-arrows-left-right
                    span "Compact"
                  button.tgl-btn-toolbar.tgl-export-csv type="button" title="Export Table to CSV"
                    span.fa-solid.fa-download
                    span "Export CSV"

              div.tgl-table-wrap.table-orders
                div.tgl-thead
                  div.tgl-th.col-check
                    input.tgl-check-all type="checkbox" aria-label="Select all orders"
