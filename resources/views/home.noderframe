html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="robots" content="index, follow"
    meta name="description" content="{{description}}"
    title "{{pageTitle}} | {{siteName}}"
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    link rel="stylesheet" href="/public/vendor/fontawesome/css/all.min.css"
    link rel="stylesheet" href="/public/home.css"
  body.tgl-home
    header.tgl-nav
      div.tgl-container.tgl-nav-inner
        a.tgl-logo href="/"
          span.tgl-logo-icon
            span.fa-solid.fa-wand-magic-sparkles
          span "TeenGirlsLK"
        nav.tgl-nav-links aria-label="Main"
          a href="#categories" "Shop"
          a href="#new-arrivals" "New Arrivals"
          a href="#perks" "Why Us"
        div.tgl-nav-actions
          if customer
            a.tgl-btn.tgl-btn-ghost href="/customer/wishlist" aria-label="Wishlist"
              span.fa-regular.fa-heart
            a.tgl-btn.tgl-btn-primary href="/customer/dashboard"
              span.fa-solid.fa-user
              span "My Account"
          else
            a.tgl-btn.tgl-btn-ghost href="/login" "Sign in"
            a.tgl-btn.tgl-btn-primary href="/register" "Join free"

    main
      section.tgl-hero
        div.tgl-container.tgl-hero-inner
          div.tgl-hero-copy
            span.tgl-eyebrow
              span.fa-solid.fa-bolt
              span "Flash sale: up to 25% off"
            h1 "Your style, your vibe."
            p "Trendy dresses, cozy knits, cute bags and beauty must-haves, delivered islandwide across Sri Lanka."
            div.tgl-hero-ctas
              a.tgl-btn.tgl-btn-primary.tgl-btn-lg href="#new-arrivals"
                span "Shop new arrivals"
                span.fa-solid.fa-arrow-right
              if customer
                a.tgl-btn.tgl-btn-outline.tgl-btn-lg href="/customer/dashboard" "Go to my account"
              else
                a.tgl-btn.tgl-btn-outline.tgl-btn-lg href="/register" "Create an account"
            p.tgl-hero-note
              span.fa-solid.fa-tag
              span "Use code TEEN10 for 10% off orders over Rs. 2,500"
          div.tgl-hero-art
            img src="/public/images/products/floral-maxi-dress.jpg" alt="Floral tiered smocked mini dress" width="420" height="520"

      section.tgl-section id="categories"
        div.tgl-container
          div.tgl-section-head
            h2 "Shop by category"
          div.tgl-category-grid
            for category in categories
              a.tgl-category href="#new-arrivals"
                span.tgl-category-icon
                  span.fa-solid class="{{category.icon}}"
                span "{{category.name}}"

      section.tgl-section.tgl-section-tint id="new-arrivals"
        div.tgl-container
          div.tgl-section-head
            h2 "New arrivals"
            p "Fresh drops picked for you this week."
          div.tgl-product-grid
            for product in products
              article.tgl-product
                div.tgl-product-media
                  img src="{{product.image}}" alt="{{product.title}}" loading="lazy" width="300" height="360"
                  if product.badge
                    span.tgl-product-badge "{{product.badge}}"
                div.tgl-product-body
                  span.tgl-product-cat "{{product.category}}"
                  h3 "{{product.title}}"
                  div.tgl-product-price
                    strong "{{product.priceLabel}}"
                    if product.originalPriceLabel
                      span.tgl-price-old "{{product.originalPriceLabel}}"

      section.tgl-section id="perks"
        div.tgl-container.tgl-perk-grid
          div.tgl-perk
            span.fa-solid.fa-truck-fast
            h3 "Islandwide delivery"
            p "Free courier delivery on orders over Rs. 3,500."
          div.tgl-perk
            span.fa-solid.fa-rotate-left
            h3 "Easy returns"
            p "Changed your mind? Return within 7 days."
          div.tgl-perk
            span.fa-solid.fa-crown
            h3 "Rewards club"
            p "Earn points on every order and unlock VIP perks."
          div.tgl-perk
            span.fa-solid.fa-lock
            h3 "Secure checkout"
            p "Cash on delivery, cards and bank transfer."

    footer.tgl-footer
      div.tgl-container.tgl-footer-inner
        span "© {{year}} TeenGirlsLK. Made with love in Sri Lanka."
        nav aria-label="Footer"
          a href="/login" "Customer login"
          a href="/customer/support" "Support"
